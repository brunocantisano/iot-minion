	"SensorReading": {
	  "type": "object",
	  "properties": {            
		"sensor": { "type": "integer", "example": 3 },
		"pin":   { "type": "string",  "example": "D3" },
		"value": { "type": "integer", "format": "int32", "example": 1 },
		"ts":    { "type": "integer", "format": "int64", "description": "epoch seconds" }
	  },
	  "required": ["sensor","value"]
	}
  },

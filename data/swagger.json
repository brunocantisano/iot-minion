   "paths":{
      "/health":{
         "get":{
            "tags":[
               "comando"
            ],
            "summary":"Checagem Health",
            "description":"Faz checagem da saúde da aplicação",
            "operationId":"health",
            "produces":[
               "application/json"
            ],
            "responses":{
               "200":{
                  "description":"OK"
               }
            }
         }
      },
      "/metrics":{
         "get":{
            "tags":[
               "comando"
            ],
            "summary":"Métricas do ESP32 (Prometheus)",
            "description":"Exibe métricas em formato texto.",
            "operationId":"metrics",
            "produces":[
               "text/plain"
            ],
            "responses":{
               "200":{
                  "description":"OK"
               }
            }
         }
      },
      "/ports": {
        "get": {
            "tags": ["comando"],
            "summary": "Lista de portas utilizadas",
            "consumes": ["application/json"],
            "produces": ["application/json"],
            "security": [{ "basicAuth": [] }],
            "description": "",
            "operationId": "getPortas",
            "parameters": [],
            "responses": {
            "200": { "description": "Comando executado com sucesso" },
            "204": { "description": "Não foi possível encontrar as informações" },
            "401": { "description": "Não autenticado" }
            }
        }
      },
      "/audios":{
         "get":{
            "tags":[
               "comando"
            ],
            "summary":"Lista de mídias disponíveis",
            "security":[
               {
                  "basicAuth":[
                     
                  ]
               }
            ],
            "produces":[
               "application/json"
            ],
            "responses":{
               "200":{
                  "description":"OK"
               },
               "401":{
                  "description":"Não autenticado"
               }
            }
         }
      },
      "/sensors": {
        "get": {
            "tags": ["comando"],
            "summary": "Busca o estado de um sensor",
            "description": "Consulta o sensor",
            "operationId": "getSensor",
            "consumes": ["application/json"],
            "produces": ["application/json"],
            "security": [{ "basicAuth": [] }],
            "parameters": [
            {
                "name": "sensor",
                "in": "query",
                "description": "Sensor (1..2)",
                "required": true,
                "type": "integer",
                "enum": [1, 2]
            }
            ],
            "responses": {
            "200": {
                "description": "Leitura realizada",
                "schema": { "$ref": "#/definitions/SensorReading" },
                "examples": {
                "application/json": {
                    "sensor": 3,
                    "pin": "D3",
                    "value": 1,
                    "ts": 1725148800
                }
                }
            },
            "400": { "description": "Parâmetros inválidos ou ausentes" },
            "401": { "description": "Não autenticado" },
            "404": { "description": "Sensor não encontrado" }
            }
        },
        "put": {
            "tags": ["comando"],
            "summary": "Atualiza o estado de um sensor",
            "description": "Permite alterar o estado (ligado/desligado) de um sensor específico",
            "operationId": "updateSensor",
            "consumes": ["application/json"],
            "produces": ["application/json"],
            "security": [{ "basicAuth": [] }],
            "parameters": [
            {
                "name": "sensor",
                "in": "query",
                "description": "Sensor (1..2)",
                "required": true,
                "type": "integer",
                "enum": [1, 2]
            },
            {
                "name": "body",
                "in": "body",
                "description": "Novo estado do sensor",
                "required": true,
                "schema": {
                "type": "object",
                "properties": {
                    "value": {
                    "type": "integer",
                    "description": "0 = desligado, 1 = ligado",
                    "enum": [0, 1]
                    }
                },
                "required": ["value"]
                }
            }
            ],
            "responses": {
            "200": {
                "description": "Estado atualizado com sucesso",
                "schema": { "$ref": "#/definitions/SensorReading" },
                "examples": {
                "application/json": {
                    "sensor": 3,
                    "pin": "D3",
                    "value": 1,
                    "ts": 1725148800
                }
                }
            },
            "400": { "description": "Parâmetros inválidos ou ausentes" },
            "401": { "description": "Não autenticado" },
            "404": { "description": "Sensor não encontrado" }
            }
        }
      },
      "/climate":{
         "get":{
            "tags":[
               "comando"
            ],
            "summary":"Clima (temperatura/umidade)",
            "description":"Retorna valor numérico como texto (celsius/fahrenheit/humidity).",
            "security":[
               {
                  "basicAuth":[
                     
                  ]
               }
            ],
            "produces":[
               "application/json",
               "text/plain"
            ],
            "parameters":[
               {
                  "name":"type",
                  "in":"query",
                  "required":true,
                  "type":"string",
                  "enum":[
                     "celsius",
                     "fahrenheit",
                     "humidity"
                  ]
               }
            ],
            "responses":{
               "200":{
                  "description":"OK"
               },
               "400":{
                  "description":"Tipo inválido"
               },
               "401":{
                  "description":"Não autenticado"
               }
            }
         }
      },
      "/talk":{
         "post":{
            "tags":[
               "comando"
            ],
            "summary":"Fala mensagem no alto-falante",
            "security":[
               {
                  "basicAuth":[
                     
                  ]
               }
            ],
            "consumes":[
               "application/json"
            ],
            "produces":[
               "text/plain"
            ],
            "parameters":[
               {
                  "in":"body",
                  "name":"body",
                  "required":true,
                  "schema":{
                     "$ref":"#/definitions/Mensagem"
                  }
               }
            ],
            "responses":{
               "200":{
                  "description":"PLAYED"
               },
               "400":{
                  "description":"PARSER_ERROR ou NOT_PLAYED"

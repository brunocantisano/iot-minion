               }
            }
         }
      },
      "/ask":{
         "post":{
            "tags":[
               "comando"
            ],
            "summary":"Pergunta ao ChatGPT e fala a resposta",
            "security":[
               {
                  "basicAuth":[
                     
                  ]
               }
            ],
            "consumes":[
               "application/json"
            ],
            "produces":[
               "text/plain"
            ],
            "parameters":[

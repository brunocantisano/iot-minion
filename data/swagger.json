   "securityDefinitions":{
      "basicAuth":{
         "type":"basic"
      }
   },
   "definitions":{
      "Lista":{
         "type":"object",
         "properties":{
            "name":{
               "type":"string",
               "description":"Nome da aplicação"
            },
            "language":{
               "type":"string",
               "description":"Linguagem de programação"
            },
            "description":{
               "type":"string",
               "description":"Descrição de execução"
            }
         },
         "required":[
            "name",
            "language",
            "description"
         ]
      },
      "Arquivo":{
         "type":"object",
         "properties":{
            "filename":{
               "type":"string",
               "format":"binary",
               "description":"Nome do arquivo"
            }
         }
      },
      "Mensagem":{
         "type":"object",
         "properties":{
            "mensagem":{
               "type":"string",
               "description":"Texto a ser falado"
            }
         },
         "required":[
            "mensagem"
         ]
      },
      "Midia":{
         "type":"object",
         "properties":{
            "midia":{
               "type":"string",
               "description":"Nome do áudio/arquivo"
            }
         },
         "required":[
            "midia"
         ]
      },
      "RemoteMidia":{
         "type":"object",
         "properties":{
            "url":{
               "type":"string",
               "description":"URL do áudio a ser tocado"
            }
         },
         "required":[
            "url"
         ]
      },
      "Volume":{
         "type":"object",
         "properties":{
            "intensidade":{
               "type":"integer",
               "format":"int32",
               "description":"Volume (padrão 70)"
            }
         },
         "required":[
            "intensidade"
         ]
      }
   },
